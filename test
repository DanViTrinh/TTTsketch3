

turn = 0

cords = [" ", " ", " ", " "," ", " "," ", " ", " "]

numbers = [0, 1, 2, 3, 4, 5, 6 , 7, 8]


def board1(cord):

    cords[numbers[cord-1]] = "X"
    print(cords)

def board2(cord):

    cords[numbers[cord - 1]] = "O"
    print(cords)

while 0 <= turn <= 8:

    if turn % 2 == 0:

        try:
            move1 = int(input("Number: "))
            board1(move1)
            numbers[move1-1] = "gone"
            print(numbers)
            print(turn)

            if turn == 8:
                print("Game over ")
                print("Play again? ")
                reset = input("Respond with Y/N ")
                try:
                    if reset == "Y":
                        turn = 0
                        numbers = [0, 1, 2, 3, 4, 5, 6 , 7, 8]
                        cords = [" ", " ", " ", " "," ", " "," ", " ", " "]
            turn += 1
            print(turn)

        except:
            print("Invalid")


    if turn % 2 != 0:
        try:
            move2 = int(input("Number: "))
            board2(move2)
            numbers[move2 - 1] = "gone"
            print(numbers)
            turn +=1

        except:
            print("Invalid")


else:
    print("game over")
